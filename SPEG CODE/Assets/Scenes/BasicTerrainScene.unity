--- !u!114 &6478948292090489797
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6478948292090489795}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce8f1ec49fb7bb14a83f71b68522ee33, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC.NPCController
  interactionRange: 3
  interactKey: 101
  dialogueLines:
  - "Old Wizard: \"Hero! You\u2019re finally here.\""
  - '"Oh, what a relief... I was afraid I might be too late."'
  - '"Forgive me. I am the Old Wizard..."'
  - '"And I have been waiting a very long time for you"'
  - '"Long ago, the Five Realms were one." '
  - '"They were shaped from a Source."'
  - '"Light above... and the Underworld below."'
  - '"Everything was in balance."'
  - '"But something terrible is happening throughout the realms."'
  - '"An entity has awakened."'
  - '"It calls itself the Architecht of Ruin."'
  - '"It is building a terrible and powerful weapon..."'
  - '"The Null Engine."'
  - '"A machine that can erase entire realms."'
  - '"Pieces of our world have already been taken."'
  - '"And it will not stop unless someone stands against it"'
  - '"That someone... is you"'
  - '"You alone can weild the Five Crowns of Power"'
  - '"They were forged from the source itself."'
  - '"Only they have the power to bring the realms back together"'
  - '"Each realm you restore by finding its crown will strengthen the realm."'
  - '"And grant you new powers to survive what lies below"'
  - '"You must descend into the Underworld."'
  - '"Find the stolen fragments."'
  - '"And stop the Null Engine before everything is lost."'
  - '"Before you embark on your journey, I have something for you."'
  - '"The first crown."'
  - '"It will give you the power to fire blasts of ancient magic."'
  - '"Follow the mushroom trail and meet me at the training ground..."'
  - '"There, I will teach you how to weild it."'
  - '"Go now, Hero."'
  - '"The fate of the Five Realms rests with you."'
  - 'After continuing - [ ] to equip your crown '
  interactPromptUI: {fileID: 2071922885}
  dialogueUI: {fileID: 1318910269}
  dialogueText: {fileID: 1230737305}

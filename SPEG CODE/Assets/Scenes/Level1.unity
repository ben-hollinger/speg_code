      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6342974689941691714, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 180
      objectReference: {fileID: 0}
    - target: {fileID: 6342974689941691714, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: dialogueUI
      value: 
      objectReference: {fileID: 1318910269}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 1230737305}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 27
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: 'Old Wizard: "Hero! You''re finally here."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: '"Oh what a relief... I was afraid I might be too late."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: Forgive me. I am the Old Wizard..."
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: '"And I have been waiting a VERY long time for you."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: '"Long ago, the Five Realms were one. Shaped entirely from the Source."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: '"Light above... and the underworld below. Everything was in balance...""'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: '"But something terrible is happening throughout the realms."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: '"An entity has awakened. It calls itself the Architect of Ruin."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[8]'
      value: '"The Architect is building a terrible and powerful weapon... a machine
        that can erase entire realms."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[9]'
      value: '"The Null Engine."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[10]'
      value: '"Pieces of our world have already been taken."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[11]'
      value: '"And it will not stop unless someone stands against it."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[12]'
      value: '"That someone... is you. "'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[13]'
      value: '"You alone can weild the Five Crowns of Power"'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[14]'
      value: '"Forged from the Source itself, they have the power to return the realms
        to harmony."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[15]'
      value: '"Each realm you restore by finding its crown will strengthen the realm."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[16]'
      value: '"You will be granted new powers to survive the dangers that lie ahead."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[17]'
      value: '"You must descend into the underworld, find the lost crowns, and stop
        the Null Engine before all is lost."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[18]'
      value: '"Before you embark on your journey, I have something for you..."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[19]'
      value: '"The first crown!"'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[20]'
      value: '"It will grant you the power to fire blasts of ancient magic from your
        hands."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[21]'
      value: '"Follow the mushroom trail and meet me at the training ground."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[22]'
      value: '"There I will teach you how to weild it."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[23]'
      value: '"Go now, Hero and make haste."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[24]'
      value: '"For the fate of the Five Realms lies with you..."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[25]'
      value: '"And the road is long and perilous."'
      objectReference: {fileID: 0}
    - target: {fileID: 7161524096741375639, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
      propertyPath: 'dialogueLines.Array.data[26]'
      value: After continuing - [H] to equip Magic Blast
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 0f80bf16690852f418127f09807cb8a8, type: 3}
